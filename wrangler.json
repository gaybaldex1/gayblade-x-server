{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gayblade-x-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["MyDurableObject"] },
		{ "tag": "v2", "renamed_classes": [{ "from": "MyDurableObject", "to": "GameRoom" }] },
		{ "tag": "v3", "new_sqlite_classes": ["Matchmaker"] }
	],
	"durable_objects": {
		"bindings": [{ "class_name": "GameRoom", "name": "ROOMS" }, { "class_name": "Matchmaker", "name": "MATCH" }]
	},
	"observability": { "enabled": true }
}
